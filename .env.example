# Copy to .env and replace the placeholder values. Never commit .env.
# All values below are examples only.

# --- PostgreSQL ---
POSTGRES_DB=postulaai
POSTGRES_USER=postulaai
POSTGRES_PASSWORD=change-me-local-only

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
# Local `dotnet run` reads ConnectionStrings__Postgres; Docker Compose builds it from the values above.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=postulaai;Username=postulaai;Password=change-me-local-only
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Used from Phase 1.
JWT_SIGNING_KEY=

# --- Claude API (backend only; never exposed to the frontend). Used from Phase 3. ---
ANTHROPIC_API_KEY=
# Model id is configurable; leave empty to use the backend default once Phase 3 is implemented.
ANTHROPIC_MODEL=
