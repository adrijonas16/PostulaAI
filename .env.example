# Copy to .env and replace the placeholder values. Never commit .env.
# All values below are examples only.

# --- Host ports (change them if another program already uses one) ---
WEB_HOST_PORT=5173
API_HOST_PORT=58080
POSTGRES_HOST_PORT=55432

# --- PostgreSQL ---
POSTGRES_DB=postulaai
POSTGRES_USER=postulaai
POSTGRES_PASSWORD=change-me-local-only

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
# Local `dotnet run` reads ConnectionStrings__Postgres; Docker Compose builds it from the values above.
ConnectionStrings__Postgres=Host=localhost;Port=55432;Database=postulaai;Username=postulaai;Password=change-me-local-only
# Required. At least 32 random bytes, e.g. `openssl rand -base64 48`. Never reuse across environments.
JWT_SIGNING_KEY=

# --- Claude API (backend only; never exposed to the frontend). Required for real analyses. ---
ANTHROPIC_API_KEY=
# Optional. Empty = backend default (claude-sonnet-5-5).
ANTHROPIC_MODEL=

# --- E-mail (verification links). Locally they go to Mailpit: http://localhost:8025 ---
# For production set a real SMTP provider; credentials only in the deployment's secret store.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=PostulaAI <no-reply@postulaai.local>
APP_BASE_URL=http://localhost:5173
MAIL_UI_HOST_PORT=8025

# --- AI cost control ---
# Site-wide ceiling on AI requests (analyses + CV imports, all users) per rolling 24 h. 0 = no ceiling.
AI_DAILY_MAX_REQUESTS=200
